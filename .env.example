# Speech Adventure — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (.env* pattern in .gitignore).
# This file (.env.example) is safe to commit — it contains ONLY placeholders.
#
# How to get Supabase values:
#   1. Create a project at https://app.supabase.com
#   2. Go to Project Settings → API
#   3. Copy "Project URL" → NEXT_PUBLIC_SUPABASE_URL
#   4. Copy "anon public" key → NEXT_PUBLIC_SUPABASE_ANON_KEY
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage Provider ──────────────────────────────────────────────────────────
# Controls which repository backend the app uses.
# Allowed values: local | supabase | hybrid
# Default (when unset): local
#
# - "local"    → all data in browser localStorage (default, no Supabase needed)
# - "supabase" → all data in Supabase (requires URL + KEY + user auth session)
# - "hybrid"   → Supabase primary, localStorage fallback
#
# Keep "local" until Supabase credentials are real.
NEXT_PUBLIC_STORAGE_PROVIDER=local

# ── Supabase Project ──────────────────────────────────────────────────────────
# Required for Supabase Auth and cloud storage (any provider other than "local")
# Leave as placeholder to run in localStorage-only mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-side only: local dev scripts (scripts/dev, scripts/line-login). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Speech Evaluation Provider ────────────────────────────────────────────────
# Controls which AI backend evaluates speech attempts.
# Allowed values: mock | openai
# Default (when unset): mock
#
# - "mock"   → deterministic fake scores, no API call, free (default)
# - "openai" → Whisper transcription + GPT scoring; requires OPENAI_API_KEY
#
# SERVER-SIDE ONLY — do NOT prefix with NEXT_PUBLIC_
SPEECH_EVALUATION_PROVIDER=mock

# Central assessment POC (/platform/assessment and /api/assessment/*).
# Separate from the legacy SPEECH_EVALUATION_PROVIDER above.
# Keep keys server-only. Requires SUPABASE_SERVICE_ROLE_KEY and the 20261116001300 migration.
# Configure Azure, restart Next.js, then publish an enabled policy as platform admin.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional resource endpoint, preferred when using Azure custom-subdomain resources.
#AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# Which provider the central assessment uses for speech items: openai | azure
# Default (when unset): openai, which uses ASSESSMENT_OPENAI_API_KEY below.
# OpenAI transcribes the clip; the server compares the text with the target word.
# It does not score pronunciation quality the way Azure would.
ASSESSMENT_SPEECH_PROVIDER=openai
# OpenAI key for the central assessment only (an OpenAI key, not OpenRouter sk-or-…).
# Its own name on purpose: an OPENAI_API_KEY set in Windows for other tools would
# override .env.local, and this keeps the project on its own key and budget.
# Prefer a project-scoped key with a monthly budget limit set by the key owner.
ASSESSMENT_OPENAI_API_KEY=
# Transcription model for the central assessment (optional override).
# gpt-4o-transcribe / gpt-4o-mini-transcribe return confidence; other models
# give confidence 0, so every AI result goes to adult review.
#OPENAI_ASSESSMENT_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Check a key without starting the app: npm run assessment:check-openai

# Claude writes the end-of-round summary for adults (text only; Claude never
# receives audio or the child's name). Off until a platform admin enables
# "สรุปรอบด้วย Claude" in /platform/assessment and publishes.
# Its own variable name so it cannot clash with ANTHROPIC_API_KEY used by
# Claude Code or other tools on a developer's machine. Server-side only.
ASSESSMENT_ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
#ASSESSMENT_CLAUDE_MODEL=claude-opus-5-5
# Check a key without starting the app: npm run assessment:check-claude

# ── Sample Audio Provider ─────────────────────────────────────────────────────
# Controls which backend generates sample audio for practice items.
# Allowed values: mock | openai
# Default (when unset): mock
#
# - "mock"   → browser speechSynthesis TTS (free, no API key needed)
# - "openai" → OpenAI TTS (better quality); requires OPENAI_API_KEY
#
# SERVER-SIDE ONLY — do NOT prefix with NEXT_PUBLIC_
SAMPLE_AUDIO_PROVIDER=mock

# ── OpenAI Credentials ────────────────────────────────────────────────────────
# Required only when SPEECH_EVALUATION_PROVIDER=openai or SAMPLE_AUDIO_PROVIDER=openai
# (legacy features). The central assessment uses ASSESSMENT_OPENAI_API_KEY above.
# SERVER-SIDE ONLY — never use NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=sk-your-openai-key-here

# ── OpenAI Model Overrides (optional) ────────────────────────────────────────
# These have safe defaults — only set to override.
# OPENAI_TTS_MODEL defaults to "tts-1" (faster/cheaper; use "tts-1-hd" for quality)
# OPENAI_TTS_VOICE defaults to "alloy" (neutral Thai-capable voice)
#OPENAI_TTS_MODEL=tts-1
#OPENAI_TTS_VOICE=alloy
